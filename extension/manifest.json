{
  "manifest_version": 3,
  "name": "Delft Browser",
  "version": "0.2.8",
  "description": "Delft-method language practice on any web page: listen to a native speaker, record yourself, compare, sentence by sentence.",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "declarativeNetRequest",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://speech.platform.bing.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Delft Browser"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "edge_tts_ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}