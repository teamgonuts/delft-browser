{
  "manifest_version": 3,
  "name": "Delft Browser (PoC)",
  "version": "0.1.0",
  "description": "Delft-method language practice on any web page: listen to a native speaker, record yourself, compare, sentence by sentence.",
  "permissions": ["sidePanel", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Delft Browser" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "128": "icon128.png" }
}
